#!/usr/bin/env bash
# Fast mech checks.
# Install once: git config core.hooksPath .githooks
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

staged_ignored="$(
  git diff --cached --name-only -z --diff-filter=ACMR \
    | git check-ignore --no-index --stdin -z 2>/dev/null \
    | tr '\0' '\n' \
    | sed '/^$/d' \
    || true
)"

if [[ -n "$staged_ignored" ]]; then
  echo "pre-commit: ignored paths staged"
  printf '%s\n' "$staged_ignored"
  echo "unstage ignored paths before commit"
  exit 1
fi

if ! command -v taplo >/dev/null 2>&1; then
  echo "pre-commit: need taplo"
  echo "install: cargo install taplo-cli --locked"
  exit 1
fi

echo "pre-commit: taplo fmt --check Cargo.toml taplo.toml"
taplo fmt --check Cargo.toml taplo.toml

echo "pre-commit: cargo fmt --all -- --check"
rtk cargo fmt --all -- --check

echo "pre-commit: cargo clippy --all-targets -- -D warnings"
rtk cargo clippy --all-targets -- -D warnings
