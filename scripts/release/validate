#!/usr/bin/env bash
set -euo pipefail

tag="${1:-}"
cargo_toml="${2:-Cargo.toml}"
cargo_lock="${3:-Cargo.lock}"
changelog="${4:-CHANGELOG.md}"

package_version="$({
  awk '
    $0 == "[package]" { inside = 1; next }
    inside && /^\[/ { exit }
    inside && /^version = "/ {
      value = $0
      sub(/^version = "/, "", value)
      sub(/".*$/, "", value)
      print value
      exit
    }
  ' "$cargo_toml"
})"

lock_version="$({
  awk '
    $0 == "[[package]]" { inside = 1; name = ""; version = ""; next }
    inside && /^name = "/ {
      name = $0
      sub(/^name = "/, "", name)
      sub(/".*$/, "", name)
    }
    inside && /^version = "/ {
      version = $0
      sub(/^version = "/, "", version)
      sub(/".*$/, "", version)
    }
    inside && name == "cowork" && version != "" { print version; exit }
  ' "$cargo_lock"
})"

if [[ -z "$package_version" || -z "$lock_version" ]]; then
  echo "missing cowork package version" >&2
  exit 1
fi

if [[ "$package_version" != "$lock_version" ]]; then
  echo "Cargo.toml version $package_version does not match Cargo.lock version $lock_version" >&2
  exit 1
fi

if [[ -z "$tag" ]]; then
  tag="v${package_version}"
fi

if [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  prerelease=false
elif [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+-rc\.[1-9][0-9]*$ ]]; then
  prerelease=true
else
  echo "invalid release tag: $tag" >&2
  exit 1
fi

if [[ "${tag#v}" != "$package_version" ]]; then
  echo "tag $tag does not match package version $package_version" >&2
  exit 1
fi

if ! grep -Eq "^# ${tag}(, [0-9]{4}-[0-9]{2}-[0-9]{2})?$" "$changelog"; then
  echo "missing top-level CHANGELOG heading for $tag" >&2
  exit 1
fi

if [[ -n "${GITHUB_OUTPUT:-}" ]]; then
  printf 'prerelease=%s\n' "$prerelease" >>"$GITHUB_OUTPUT"
fi
